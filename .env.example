# ============================================================================
# Maya Poetry Book Awards — environment variables
# Copy this file to `.env.local` and fill in your values before running locally:
#   cp .env.example .env.local   (Windows:  copy .env.example .env.local)
# Variables marked [required] must be set for the feature they power. Optional
# variables can be left blank or removed. See README.md for full instructions.
# NEVER commit your real `.env.local` — it is gitignored.
# ============================================================================

# --- Prismic (CMS) -----------------------------------------------------------
# Optional override of the Prismic repository name. Defaults to "poetry-site"
# from slicemachine.config.json, so you can usually leave this blank.
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=poetry-site

# --- Stripe (Payments) ------------------------------------------------------
# [required for the /enter payment flow]
# Server-side secret key (sk_live_... / sk_test_...) — used to create PaymentIntents.
STRIPE_SECRET_KEY=
# Publishable key (pk_live_... / pk_test_...) — used in the browser PaymentForm.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (Transactional email) -------------------------------------------
# [required for entry confirmation / admin / contact-form emails]
RESEND_API_KEY=
# Verified sender address used on outgoing emails (e.g. "Maya Awards <no-reply@yourdomain.com>").
EMAIL_FROM=
# Inbox that receives new-entry notifications and contact-form messages.
ADMIN_EMAIL=

# --- Sequenzy (Newsletter) ---------------------------------------------------
# [required for the newsletter signup]
# API key from Sequenzy dashboard → Settings → API Keys & SMTP.
# Needs at least the subscribers:write scope.
SEQUENZY_API_KEY=
# Optional: Sequenzy list ID to add subscribers to. If omitted, workspace
# default lists are used for new subscribers.
SEQUENZY_LIST_ID=
# Optional: workspace / company ID. Required when using an account API key
# (seq_user_...) so requests target the correct workspace (x-company-id header).
SEQUENZY_COMPANY_ID=
# Set to "true" to disable Sequenzy calls entirely (handy for local-only testing).
SKIP_SEQUENZY=true

# --- Google Sheets (Entry / contact data storage) ----------------------------
# [required for storing competition entries and contact-form messages]
# ID from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<THIS_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Google Cloud Service Account used for JWT auth (email from the service account JSON).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key from the same service account JSON. Keep the \n escapes verbatim:
#   GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional: override tab used for entries (defaults to a tab named "Entries").
GOOGLE_SHEETS_TAB_NAME=
# Optional: override tab used for contact-form messages (defaults to "Messages").
GOOGLE_SHEETS_MESSAGES_TAB_NAME=
# Set to "true" to skip Google Sheets entirely (newsletter/emails still work).
SKIP_GOOGLE_SHEETS=true

# --- Feature flags / testing -------------------------------------------------
# Set to "true" to ignore the real competition close date and keep /enter usable
# for local testing (shifts open/close dates to ±6 months from today).
IGNORE_COMPETITION_CLOSE=true