generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------
// ENUMS
// -------------------------------------

enum Role {
  ENTRANT
  SUBJUDGE
  JUDGE
  ADMIN
}

enum BookStatus {
  SUBMITTED
  RECEIVED
  SUB_SELECTED
  SUB_SENT
  SUB_REJECTED
  MAIN_RECEIVED
}

enum CheckoutStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  COMPLETED
}

// -------------------------------------
// USER
// -------------------------------------

model User {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(255)
  email        String  @unique @db.VarChar(255)
  passwordHash String? @map("password_hash") @db.VarChar(255)
  phoneNumber  String? @map("phone_number") @db.VarChar(50)
  role         Role    @default(ENTRANT)

  // Ghost account and Stripe integration
  isGhost          Boolean @default(false) @map("is_ghost")
  stripeCustomerId String? @unique @map("stripe_customer_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  judgeProfile     JudgeProfile?
  submissions      Submission[]
  judgements       Judgement[]
  pendingCheckouts PendingCheckout[]

  @@map("users")
}

// -------------------------------------
// PENDING CHECKOUT
// -------------------------------------

model PendingCheckout {
  id                    String         @id @default(uuid()) @db.Uuid
  userId                String         @map("user_id") @db.Uuid
  competitionId         String         @map("competition_id") @db.Uuid
  stripePaymentIntentId String?        @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  entryToken            String         @unique @map("entry_token") @db.VarChar(100)
  bookTitles            String[]       @map("book_titles")
  expectedAmountPence   Int            @map("expected_amount_pence")
  currency              String         @default("gbp") @db.VarChar(3)
  status                CheckoutStatus @default(PENDING)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  user        User                @relation(fields: [userId], references: [id])
  competition Competition         @relation(fields: [competitionId], references: [id])
  submission  Submission?
  fulfillment PaymentFulfillment?

  @@index([userId])
  @@index([competitionId])
  @@map("pending_checkouts")
}

model PaymentFulfillment {
  id         String @id @default(uuid()) @db.Uuid
  checkoutId String @unique @map("checkout_id") @db.Uuid

  sheetsSyncedAt   DateTime? @map("sheets_synced_at")
  entrantEmailedAt DateTime? @map("entrant_emailed_at")
  adminEmailedAt   DateTime? @map("admin_emailed_at")

  lastError String? @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  checkout PendingCheckout @relation(fields: [checkoutId], references: [id])

  sheetsStatus    FulfillmentStatus @default(PENDING) @map("sheets_status")
  sheetsClaimedAt DateTime?         @map("sheets_claimed_at")

  @@map("payment_fulfillments")
}

// -------------------------------------
// JUDGE PROFILE
// -------------------------------------

model JudgeProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  title     String?  @db.VarChar(100)
  address   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("judge_profiles")
}

// -------------------------------------
// COMPETITION
// -------------------------------------

model Competition {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  entryFee    Decimal  @default(0) @map("entry_fee") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  submissions      Submission[]
  pendingCheckouts PendingCheckout[]

  @@map("competitions")
}

// -------------------------------------
// SUBMISSION
// -------------------------------------

model Submission {
  id                String   @id @default(uuid()) @db.Uuid
  competitionId     String   @map("competition_id") @db.Uuid
  entrantId         String   @map("entrant_id") @db.Uuid
  pendingCheckoutId String?  @unique @map("pending_checkout_id") @db.Uuid
  title             String   @db.VarChar(255)
  coverImageUrl     String?  @map("cover_image_url") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  competition     Competition      @relation(fields: [competitionId], references: [id])
  entrant         User             @relation(fields: [entrantId], references: [id])
  pendingCheckout PendingCheckout? @relation(fields: [pendingCheckoutId], references: [id])
  books           Book[]

  @@index([competitionId])
  @@index([entrantId])
  @@map("submissions")
}

// -------------------------------------
// BOOK
// -------------------------------------

model Book {
  id            String     @id @default(uuid()) @db.Uuid
  submissionId  String     @map("submission_id") @db.Uuid
  prizeId       String?    @map("prize_id") @db.Uuid
  reference     String     @unique @db.VarChar(50)
  title         String     @db.VarChar(255)
  coverImageUrl String?    @map("cover_image_url") @db.Text
  status        BookStatus @default(SUBMITTED)
  qrCodeUrl     String?    @map("qr_code_url") @db.Text
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  submission Submission  @relation(fields: [submissionId], references: [id])
  prize      Prize?      @relation(fields: [prizeId], references: [id])
  judgements Judgement[]

  @@index([submissionId])
  @@index([prizeId])
  @@map("books")
}

// -------------------------------------
// JUDGEMENT
// -------------------------------------

model Judgement {
  id        String    @id @default(uuid()) @db.Uuid
  bookId    String    @map("book_id") @db.Uuid
  judgeId   String    @map("judge_id") @db.Uuid
  feedback  String?   @db.Text
  selected  Boolean?
  judgedAt  DateTime? @map("judged_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  book  Book @relation(fields: [bookId], references: [id])
  judge User @relation(fields: [judgeId], references: [id])

  @@unique([bookId, judgeId])
  @@index([judgeId])
  @@map("judgements")
}

// -------------------------------------
// PRIZE
// -------------------------------------

model Prize {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(50)
  description  String?  @db.Text
  displayOrder Int      @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  books Book[]

  @@map("prizes")
}
