{
  "id": "judge_profile",
  "type": "SharedSlice",
  "name": "JudgeProfile",
  "description": "Judge biography and book showcase",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default judge profile",
      "imageUrl": "",
      "primary": {
        "name": {
          "type": "Text",
          "config": {
            "label": "Name",
            "placeholder": "Judge name..."
          }
        },
        "title": {
          "type": "Text",
          "config": {
            "label": "Title",
            "placeholder": "Author, Entrepreneur..."
          }
        },
        "location": {
          "type": "Text",
          "config": {
            "label": "Location",
            "placeholder": "Cardiff, Wales"
          }
        },
        "portrait": {
          "type": "Image",
          "config": {
            "label": "Portrait",
            "constraint": {
              "width": 400,
              "height": 400
            },
            "thumbnails": []
          }
        },
        "bio": {
          "type": "StructuredText",
          "config": {
            "label": "Biography",
            "placeholder": "Enter biography...",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
          }
        },
        "entrepreneurial_history_heading": {
          "type": "Text",
          "config": {
            "label": "Entrepreneurial History Heading",
            "placeholder": "Entrepreneurial History"
          }
        },
        "entrepreneurial_history": {
          "type": "StructuredText",
          "config": {
            "label": "Entrepreneurial History",
            "placeholder": "Enter entrepreneurial history...",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
          }
        },
        "literary_history_heading": {
          "type": "Text",
          "config": {
            "label": "Literary History Heading",
            "placeholder": "Literary History"
          }
        },
        "literary_history": {
          "type": "StructuredText",
          "config": {
            "label": "Literary History",
            "placeholder": "Enter literary history...",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
          }
        },
        "books": {
          "type": "Group",
          "config": {
            "label": "Books",
            "fields": {
              "book_title": {
                "type": "Text",
                "config": {
                  "label": "Book Title",
                  "placeholder": "Enter book title..."
                }
              },
              "book_image": {
                "type": "Image",
                "config": {
                  "label": "Book Cover",
                  "constraint": {
                    "width": 300,
                    "height": 450
                  },
                  "thumbnails": []
                }
              },
              "book_amazon_url": {
                "type": "Text",
                "config": {
                  "label": "Amazon URL",
                  "placeholder": "https://amazon.com/..."
                }
              },
              "book_description": {
                "type": "Text",
                "config": {
                  "label": "Description",
                  "placeholder": "Short description..."
                }
              }
            }
          }
        },
        "preliminary_judges_heading": {
          "type": "Text",
          "config": {
            "label": "Preliminary Judges Heading",
            "placeholder": "Preliminary Judges"
          }
        },
        "preliminary_judges": {
          "type": "Group",
          "config": {
            "label": "Preliminary Judges",
            "fields": {
              "profile_picture": {
                "type": "Image",
                "config": {
                  "label": "Profile Picture",
                  "constraint": {
                    "width": 400,
                    "height": 400
                  },
                  "thumbnails": []
                }
              },
              "name": {
                "type": "Text",
                "config": {
                  "label": "Name",
                  "placeholder": "Judge name..."
                }
              },
              "biography": {
                "type": "StructuredText",
                "config": {
                  "label": "Biography",
                  "placeholder": "Enter biography...",
                  "allowTargetBlank": true,
                  "multi": "paragraph,strong,em,hyperlink"
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}